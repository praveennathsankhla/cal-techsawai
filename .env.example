# ---------------------------------------------------------------------------
# TechSawai environment
# Copy this file to .env.local for local development, to .env for Docker
# Compose, or add the same keys to your hosting provider. Never commit secrets.
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, hreflang, sitemap.xml and robots.txt.
# Set this BEFORE building. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://techsawai.com

# Optional: deliver contact form submissions by email through Resend.
# Without this, submissions are only appended to .data/contact-messages.jsonl.
# RESEND_API_KEY=re_xxxxxxxxx
# CONTACT_FROM_EMAIL="TechSawai <hello@techsawai.com>"
# CONTACT_TO_EMAIL=pnath6745@gmail.com
